# Variáveis de Ambiente para o Deploy Real

# 1. Chave da API Gemini
REACT_APP_GEMINI_API_KEY="SUA_CHAVE_COMPLETA_DA_API_GEMINI_AQUI"

# 2. Configurações do Firebase
# Cole a CONFIGURAÇÃO COMPLETA do Firebase como uma string JSON, com aspas em volta!
REACT_APP_FIREBASE_CONFIG='{"apiKey":"SUA_API_KEY_FIREBASE","authDomain":"seu-dominio.firebaseapp.com","projectId":"seu-id-do-projeto","storageBucket":"seu-storage.appspot.com","messagingSenderId":"seu-sender-id","appId":"seu-app-id"}'

# 3. ID do Aplicativo (Usado para isolar os dados no Firestore)
REACT_APP_APP_ID="vending-app-producao"